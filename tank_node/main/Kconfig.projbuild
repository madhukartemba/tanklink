menu "TankLink Tank Node"

    config TANK_FLOAT_FULL_GPIO
        int "Float FULL GPIO (HIGH = full / disconnect)"
        range 0 21
        default 4

    config TANK_ENABLE_EMPTY_FLOAT
        bool "Enable almost-empty float switch"
        default y
        help
            HIGH = almost empty or disconnect (fail-safe). Default D3/GPIO5.

    config TANK_FLOAT_EMPTY_GPIO
        int "Float ALMOST EMPTY GPIO (HIGH = empty / disconnect)"
        depends on TANK_ENABLE_EMPTY_FLOAT
        range 0 21
        default 5

    config TANK_BUTTON_GPIO
        int "Button GPIO (to GND, active low)"
        range 0 21
        default 3

    config TANK_LED_GPIO
        int "Status LED GPIO"
        range 0 21
        default 7
        help
            Default D5/GPIO7. Do not use D4/GPIO6 (MTCK) — ROM JTAG pull-up
            faintly lights the LED at every reset before app_main runs.

    config TANK_BAT_ADC_GPIO
        int "Battery ADC GPIO"
        range 0 21
        default 2

    config TANK_LORA_SCK_GPIO
        int "LoRa SCK GPIO"
        default 8
        help
            XIAO D8/GPIO8 (default SPI SCK). Add 10 kΩ pull-up to 3V3 so boot
            strap stays HIGH (Seeed + SX1278 on C3 guidance).

    config TANK_LORA_MISO_GPIO
        int "LoRa MISO GPIO"
        default 21
        help
            Must NOT be GPIO9/D9 (BOOT). SX1278 pulls MISO low at power-up.

    config TANK_LORA_MOSI_GPIO
        int "LoRa MOSI GPIO"
        default 10

    config TANK_LORA_CS_GPIO
        int "LoRa NSS/CS GPIO"
        default 20
        help
            10 kΩ pull-up to 3V3 required (boot + deep sleep).

    config TANK_LORA_RST_GPIO
        int "LoRa RESET GPIO (-1 = 10k to 3V3 only)"
        range -1 21
        default 9
        help
            Default D9/GPIO9. Idle-high is fine for normal boot; hold BOOT to
            flash. Use -1 only if RESET is hard-wired high with 10 kΩ.

    config TANK_LORA_DIO0_GPIO
        int "LoRa DIO0 GPIO (-1 = unused)"
        range -1 21
        default 6
        help
            Default D4/GPIO6 (swapped with LED). IRQ also polled over SPI.
            Weak ROM pull-up on MTCK is fine for DIO0 input.

    config TANK_LORA_FREQ_HZ
        int "LoRa frequency (Hz)"
        default 433000000

    config TANK_DEMO_NO_SLEEP
        bool "Stay awake (demo / USB monitor)"
        default n
        help
            Skip deep sleep and loop heartbeats so USB-Serial/JTAG stays connected.

    config TANK_HEARTBEAT_SEC
        int "Heartbeat / max sleep interval (seconds)"
        range 5 86400
        default 300
        help
            Deep-sleep timer wake so the pump sees a periodic alive status.
            In demo no-sleep mode this is the loop period instead.

    config TANK_BUTTON_HOLD_MS
        int "Button hold to restart pairing (ms)"
        range 1000 15000
        default 5000
        help
            Must be clearly longer than a short press used for status TX / BLE OTA.
            Default 5s so a firm press for OTA is not mistaken for LoRa re-pair.

    config TANK_BUTTON_AWAKE_MS
        int "Stay awake after short button press (ms)"
        range 0 60000
        default 10000
        help
            After a short-press status TX, remain awake this long if BLE OTA window is not used
            (hold-to-pair still works). Prefer TANK_BLE_OTA_WINDOW_MS when paired.

    config TANK_BLE_OTA_WINDOW_MS
        int "BLE OTA advertise window after short press (ms)"
        range 10000 600000
        default 10000
        help
            After a paired short-press status TX, advertise BLE for this long so the phone
            can push a firmware update. Hold-to-pair still works if pressed during the window.

    config TANK_PAIR_WINDOW_MS
        int "Pairing mode timeout (ms)"
        range 10000 300000
        default 30000
        help
            After hold-to-pair, flash and retry PAIR until ACK, cancel, or this timeout.

    config TANK_TX_RETRIES
        int "LoRa TX attempts (until ACK)"
        range 1 8
        default 5
        help
            Each attempt: send packet, wait for pump ACK. Sleep after success or exhaustion.

    config TANK_ACK_TIMEOUT_MS
        int "LoRa ACK wait timeout per attempt (ms)"
        range 100 5000
        default 800

endmenu
