# Seeed XIAO ESP32-C3 — USB Serial/JTAG
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

CONFIG_TANK_FLOAT_FULL_GPIO=4
CONFIG_TANK_ENABLE_EMPTY_FLOAT=y
CONFIG_TANK_FLOAT_EMPTY_GPIO=5
CONFIG_TANK_BUTTON_GPIO=3
CONFIG_TANK_LED_GPIO=6
CONFIG_TANK_BAT_ADC_GPIO=2

# XIAO default SPI silkscreen + MCU RESET. MISO must NOT be on D9 (BOOT).
# Required HW: 10k NSS→3V3, 10k SCK→3V3 (keeps straps safe at boot / sleep).
CONFIG_TANK_LORA_SCK_GPIO=8
CONFIG_TANK_LORA_MISO_GPIO=21
CONFIG_TANK_LORA_MOSI_GPIO=10
CONFIG_TANK_LORA_CS_GPIO=20
CONFIG_TANK_LORA_RST_GPIO=9
CONFIG_TANK_LORA_DIO0_GPIO=7
CONFIG_TANK_LORA_FREQ_HZ=433000000

CONFIG_TANK_DEMO_NO_SLEEP=n
CONFIG_TANK_HEARTBEAT_SEC=600
CONFIG_TANK_BUTTON_HOLD_MS=5000
CONFIG_TANK_BUTTON_AWAKE_MS=10000
CONFIG_TANK_BLE_OTA_WINDOW_MS=10000
CONFIG_TANK_PAIR_WINDOW_MS=30000
CONFIG_TANK_TX_RETRIES=3
CONFIG_TANK_ACK_TIMEOUT_MS=800
