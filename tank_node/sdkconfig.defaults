# Seeed XIAO ESP32-C3 — USB Serial/JTAG
CONFIG_IDF_TARGET="esp32c3"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Keep light; tank node has no BLE
CONFIG_BT_ENABLED=n

CONFIG_TANK_FLOAT_FULL_GPIO=4
CONFIG_TANK_ENABLE_EMPTY_FLOAT=n
CONFIG_TANK_FLOAT_EMPTY_GPIO=5
CONFIG_TANK_BUTTON_GPIO=3
CONFIG_TANK_LED_GPIO=6
CONFIG_TANK_BAT_ADC_GPIO=2

# MISO on D6 (GPIO21), RESET on D9 (GPIO9) — avoids download-strap on MISO
CONFIG_TANK_LORA_SCK_GPIO=8
CONFIG_TANK_LORA_MISO_GPIO=21
CONFIG_TANK_LORA_MOSI_GPIO=10
CONFIG_TANK_LORA_CS_GPIO=20
CONFIG_TANK_LORA_RST_GPIO=9
CONFIG_TANK_LORA_DIO0_GPIO=7
CONFIG_TANK_LORA_FREQ_HZ=433000000

CONFIG_TANK_DEMO_NO_SLEEP=n
CONFIG_TANK_HEARTBEAT_SEC=600
CONFIG_TANK_BUTTON_HOLD_MS=3000
CONFIG_TANK_BUTTON_AWAKE_MS=10000
CONFIG_TANK_PAIR_WINDOW_MS=60000
CONFIG_TANK_TX_RETRIES=3
CONFIG_TANK_ACK_TIMEOUT_MS=800
