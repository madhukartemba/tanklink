menu "Pump Board"

    config PUMP_ENABLE_NEOPIXEL
        bool "Enable NeoPixel status LED"
        default y
        help
            WS2812 status LED(s) via esp-idf led_strip.

    config PUMP_NEOPIXEL_GPIO
        int "NeoPixel (WS2812) GPIO"
        depends on PUMP_ENABLE_NEOPIXEL
        range 0 21
        default 20
        help
            Data pin (fresh C3 board default GPIO 20).

    config PUMP_NEOPIXEL_COUNT
        int "NeoPixel count"
        depends on PUMP_ENABLE_NEOPIXEL
        range 1 16
        default 11
        help
            Number of LEDs on the status strip (linear bar).

    config PUMP_ENABLE_BUTTON
        bool "Enable local Start/Stop buttons"
        default y
        help
            Momentary Start and Stop. Hold both for BLE phone pairing.

    config PUMP_BUTTON_START_GPIO
        int "Start button GPIO"
        depends on PUMP_ENABLE_BUTTON
        range 0 21
        default 0
        help
            Active-low to GND. Short press = pump ON.

    config PUMP_BUTTON_STOP_GPIO
        int "Stop button GPIO"
        depends on PUMP_ENABLE_BUTTON
        range 0 21
        default 1
        help
            Active-low to GND. Short press = pump OFF / exit BLE pairing.

    config PUMP_BUTTON_ACTIVE_LOW
        bool "Buttons are active low"
        depends on PUMP_ENABLE_BUTTON
        default y
        help
            Buttons to GND with internal pull-up (inverted).

    config PUMP_PAIRING_HOLD_MS
        int "Hold both buttons to enter BLE pairing (ms)"
        depends on PUMP_ENABLE_BUTTON
        range 1000 15000
        default 5000

    config PUMP_PAIRING_TIMEOUT_MS
        int "Pairing window timeout (ms)"
        range 10000 300000
        default 60000

    config PUMP_ENABLE_BUZZER
        bool "Enable buzzer"
        default y
        help
            Active buzzer on the kitchen-gas-alarm board (GPIO HIGH = on).

    config PUMP_BUZZER_GPIO
        int "Buzzer GPIO"
        depends on PUMP_ENABLE_BUZZER
        range 0 21
        default 21

    config PUMP_RELAY_START_GPIO
        int "Starter relay A / START GPIO (−1 = unassigned)"
        range -1 21
        default -1
        help
            Two-button starter START. Leave −1 until wired (LoRa-only tests OK).

    config PUMP_RELAY_STOP_GPIO
        int "Starter relay B / STOP GPIO (−1 = unassigned)"
        range -1 21
        default -1
        help
            Two-button starter STOP (normally-closed path). −1 = unassigned.

    config PUMP_ENABLE_LORA
        bool "Enable RA-02 LoRa (tank link)"
        default y

    config PUMP_LORA_SCK_GPIO
        int "LoRa SCK GPIO"
        depends on PUMP_ENABLE_LORA
        default 10

    config PUMP_LORA_MOSI_GPIO
        int "LoRa MOSI GPIO"
        depends on PUMP_ENABLE_LORA
        default 3

    config PUMP_LORA_MISO_GPIO
        int "LoRa MISO GPIO"
        depends on PUMP_ENABLE_LORA
        default 2

    config PUMP_LORA_CS_GPIO
        int "LoRa NSS/CS GPIO"
        depends on PUMP_ENABLE_LORA
        default 5

    config PUMP_LORA_RST_GPIO
        int "LoRa RESET GPIO"
        depends on PUMP_ENABLE_LORA
        default 4

    config PUMP_LORA_DIO0_GPIO
        int "LoRa DIO0 GPIO"
        depends on PUMP_ENABLE_LORA
        default 8

    config PUMP_LORA_FREQ_HZ
        int "LoRa frequency (Hz)"
        depends on PUMP_ENABLE_LORA
        default 433000000

    config PUMP_TANK_PAIR_TIMEOUT_MS
        int "Tank LoRa pair window (ms)"
        depends on PUMP_ENABLE_LORA
        range 10000 300000
        default 60000

    config PUMP_RELAY_ACTIVE_HIGH
        bool "Relays active high"
        default y
        help
            GPIO HIGH energizes the relay coil (common for transistor drivers).

    config PUMP_RELAY_PULSE_MS
        int "Start/Stop pulse width (ms)"
        range 50 2000
        default 400
        help
            How long Start/Stop relays stay closed for a two-button starter.

endmenu
