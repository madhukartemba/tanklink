menu "Pump Board"

    config PUMP_ENABLE_NEOPIXEL
        bool "Enable NeoPixel status LED"
        default y
        help
            WS2812 status LED(s) via esp-idf led_strip.

    config PUMP_NEOPIXEL_GPIO
        int "NeoPixel (WS2812) GPIO"
        depends on PUMP_ENABLE_NEOPIXEL
        range 0 21
        default 7
        help
            Data pin (SuperMini default GPIO 7 — LoRa uses 20/21).

    config PUMP_NEOPIXEL_COUNT
        int "NeoPixel count"
        depends on PUMP_ENABLE_NEOPIXEL
        range 1 16
        default 11
        help
            Number of LEDs on the status strip (linear bar).

    config PUMP_ENABLE_BUTTON
        bool "Enable local button"
        default y
        help
            One button on GPIO 0 (default). Set Stop GPIO to −1 for single-button
            wiring; hold ~5s on that button replaces “both buttons” for BLE pair.

    config PUMP_BUTTON_START_GPIO
        int "Button GPIO"
        depends on PUMP_ENABLE_BUTTON
        range 0 21
        default 0
        help
            Active-low to GND. ~1s hold toggles pump; longer hold = pair/factory.

    config PUMP_BUTTON_STOP_GPIO
        int "Stop button GPIO (−1 = not wired)"
        depends on PUMP_ENABLE_BUTTON
        range -1 21
        default -1
        help
            Optional second button. −1 = one button only (buzzer on GPIO 1).

    config PUMP_BUTTON_ACTIVE_LOW
        bool "Buttons are active low"
        depends on PUMP_ENABLE_BUTTON
        default y
        help
            Buttons to GND with internal pull-up (inverted).

    config PUMP_ACTION_HOLD_MS
        int "Hold Start or Stop to actuate pump (ms)"
        depends on PUMP_ENABLE_BUTTON
        range 200 5000
        default 1000
        help
            Center LED expands while held; action fires at threshold.

    config PUMP_PAIRING_HOLD_MS
        int "Hold both buttons to enter BLE pairing (ms)"
        depends on PUMP_ENABLE_BUTTON
        range 1000 15000
        default 5000

    config PUMP_FACTORY_RESET_EXTRA_MS
        int "Extra hold after BLE pair for factory reset (ms)"
        depends on PUMP_ENABLE_BUTTON
        range 5000 60000
        default 10000
        help
            Keep holding Start+Stop after the 5s BLE-pair cue. Red progress
            fills for this long, then factory reset + reboot. Hard to trigger
            by accident (default 5s pair + 10s = 15s total).

    config PUMP_PAIRING_TIMEOUT_MS
        int "Pairing window timeout (ms)"
        range 10000 300000
        default 60000

    config PUMP_ENABLE_BUZZER
        bool "Enable buzzer"
        default y
        help
            Active buzzer on the kitchen-gas-alarm board (GPIO HIGH = on).

    config PUMP_BUZZER_GPIO
        int "Buzzer GPIO"
        depends on PUMP_ENABLE_BUZZER
        range 0 21
        default 1

    config PUMP_RELAY_START_GPIO
        int "Starter relay A / START GPIO (−1 = unassigned)"
        range -1 21
        default 4
        help
            Momentary START output. −1 = logical pump only (no coil).

    config PUMP_RELAY_STOP_GPIO
        int "Starter relay B / STOP GPIO (−1 = unassigned)"
        range -1 21
        default 5
        help
            Momentary STOP output. −1 = unassigned.

    config PUMP_ENABLE_LORA
        bool "Enable RA-02 LoRa (tank link)"
        default y

    config PUMP_LORA_SCK_GPIO
        int "LoRa SCK GPIO"
        depends on PUMP_ENABLE_LORA
        default 8

    config PUMP_LORA_MOSI_GPIO
        int "LoRa MOSI GPIO"
        depends on PUMP_ENABLE_LORA
        default 10

    config PUMP_LORA_MISO_GPIO
        int "LoRa MISO GPIO"
        depends on PUMP_ENABLE_LORA
        default 21

    config PUMP_LORA_CS_GPIO
        int "LoRa NSS/CS GPIO"
        depends on PUMP_ENABLE_LORA
        default 20

    config PUMP_LORA_RST_GPIO
        int "LoRa RESET GPIO"
        depends on PUMP_ENABLE_LORA
        default 9

    config PUMP_LORA_DIO0_GPIO
        int "LoRa DIO0 GPIO"
        depends on PUMP_ENABLE_LORA
        default 6

    config PUMP_LORA_FREQ_HZ
        int "LoRa frequency (Hz)"
        depends on PUMP_ENABLE_LORA
        default 433000000

    config PUMP_TANK_PAIR_TIMEOUT_MS
        int "Tank LoRa pair window (ms)"
        depends on PUMP_ENABLE_LORA
        range 10000 300000
        default 60000

    config PUMP_TANK_STALE_SEC
        int "Tank offline after no packet (seconds)"
        depends on PUMP_ENABLE_LORA
        range 10 7200
        default 1500
        help
            Mark tank out of range if no LoRa packet within this window
            (about 2.5× the default 600s heartbeat).

    config PUMP_RELAY_ACTIVE_HIGH
        bool "Relays active high"
        default y
        help
            GPIO HIGH energizes the relay coil (common for transistor drivers).

    config PUMP_RELAY_PULSE_MS
        int "Start/Stop pulse width (ms)"
        range 50 2000
        default 400
        help
            How long Start/Stop relays stay closed for a two-button starter.

endmenu
