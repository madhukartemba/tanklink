# ESP32-C3 fresh board — USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
# Room for every notify characteristic (9 today).
CONFIG_BT_NIMBLE_MAX_CCCDS=16
# GATT handlers run here: 512-byte History pages, OTA flash writes, factory
# reset. The default 4096 leaves little room.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# ESP32-C3 SuperMini pin map — see docs/PINMAPS.md.
# Relays on GPIO0/1 (quiet at boot), active-low opto module. Single button on GPIO9.
CONFIG_PUMP_ENABLE_NEOPIXEL=y
CONFIG_PUMP_NEOPIXEL_GPIO=20
CONFIG_PUMP_NEOPIXEL_COUNT=11
CONFIG_PUMP_ENABLE_BUTTON=y
CONFIG_PUMP_BUTTON_GPIO=9
CONFIG_PUMP_BUTTON_ACTIVE_LOW=y
CONFIG_PUMP_ACTION_HOLD_MS=1000
CONFIG_PUMP_PAIRING_HOLD_MS=5000
CONFIG_PUMP_TANK_STALE_SEC=750
CONFIG_PUMP_PAIRING_TIMEOUT_MS=60000
CONFIG_PUMP_ENABLE_BUZZER=y
CONFIG_PUMP_BUZZER_GPIO=21
CONFIG_PUMP_RELAY_START_GPIO=0
CONFIG_PUMP_RELAY_STOP_GPIO=1
# CONFIG_PUMP_RELAY_ACTIVE_HIGH is not set
CONFIG_PUMP_RELAY_PULSE_MS=1000

# DS3231 RTC on I2C (GPIO7 SDA, GPIO6 SCL).
CONFIG_PUMP_ENABLE_RTC=y
CONFIG_PUMP_RTC_SDA_GPIO=7
CONFIG_PUMP_RTC_SCL_GPIO=6

CONFIG_PUMP_ENABLE_LORA=y
CONFIG_PUMP_LORA_SCK_GPIO=10
CONFIG_PUMP_LORA_MOSI_GPIO=3
CONFIG_PUMP_LORA_MISO_GPIO=2
CONFIG_PUMP_LORA_CS_GPIO=5
CONFIG_PUMP_LORA_RST_GPIO=4
CONFIG_PUMP_LORA_DIO0_GPIO=8
CONFIG_PUMP_LORA_FREQ_HZ=433000000

# BLE transmit power: the C3's maximum. The pump is mains powered, and the
# SuperMini's small antenna needs every dB (default is +9 dBm).
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P20=y

# Signed firmware: OTA only takes an image signed with the TankLink release
# key (Secure Boot V2 signature block, RSA-3072). No eFuses are burned and
# the bootloader does not check, so USB flashing still works as before.
# The key is not in git: see docs/firmware-build-setup.md#signing-key.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../keys/firmware_signing_key.pem"
