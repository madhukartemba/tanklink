# ESP32-C3 fresh board — USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5
# Room for every notify characteristic (9 today).
CONFIG_BT_NIMBLE_MAX_CCCDS=16
# GATT handlers run here: 512-byte History pages, OTA flash writes, factory
# reset. The default 4096 leaves little room.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144

# A hang in the poll or LoRa task (schedules, auto-off, full-tank stop)
# restarts the pump, which leaves the relays idle and pulses Stop.
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ESP32-C3 SuperMini pin map — see docs/PINMAPS.md.
# Relays on GPIO0/1 (quiet at boot), active-low opto module. Single button on GPIO9.
CONFIG_PUMP_ENABLE_NEOPIXEL=y
CONFIG_PUMP_NEOPIXEL_GPIO=20
CONFIG_PUMP_NEOPIXEL_COUNT=11
CONFIG_PUMP_ENABLE_BUTTON=y
CONFIG_PUMP_BUTTON_GPIO=9
CONFIG_PUMP_BUTTON_ACTIVE_LOW=y
CONFIG_PUMP_ACTION_HOLD_MS=500
CONFIG_PUMP_PAIRING_HOLD_MS=5000
CONFIG_PUMP_TANK_STALE_SEC=750
CONFIG_PUMP_PAIRING_TIMEOUT_MS=60000
CONFIG_PUMP_ENABLE_BUZZER=y
CONFIG_PUMP_BUZZER_GPIO=21
CONFIG_PUMP_RELAY_START_GPIO=0
CONFIG_PUMP_RELAY_STOP_GPIO=1
# CONFIG_PUMP_RELAY_ACTIVE_HIGH is not set
CONFIG_PUMP_RELAY_PULSE_MS=1000

# DS3231 RTC on I2C (GPIO7 SDA, GPIO6 SCL).
CONFIG_PUMP_ENABLE_RTC=y
CONFIG_PUMP_RTC_SDA_GPIO=7
CONFIG_PUMP_RTC_SCL_GPIO=6

CONFIG_PUMP_ENABLE_LORA=y
CONFIG_PUMP_LORA_SCK_GPIO=10
CONFIG_PUMP_LORA_MOSI_GPIO=3
CONFIG_PUMP_LORA_MISO_GPIO=2
CONFIG_PUMP_LORA_CS_GPIO=5
CONFIG_PUMP_LORA_RST_GPIO=4
CONFIG_PUMP_LORA_DIO0_GPIO=8
CONFIG_PUMP_LORA_FREQ_HZ=433000000

# BLE transmit power: the C3's maximum. The pump is mains powered, and the
# SuperMini's small antenna needs every dB (default is +9 dBm).
CONFIG_BT_CTRL_DFT_TX_POWER_LEVEL_P20=y

# Signed firmware: OTA only takes an image signed with the TankLink release
# key (Secure Boot V2 signature block, RSA-3072). No eFuses are burned and
# the bootloader does not check, so USB flashing still works as before.
# The key is not in git: see docs/firmware-build-setup.md#signing-key.
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="../keys/firmware_signing_key.pem"

# Optional Wi-Fi (docs/plan-local-wifi.md). mDNS without its console CLI.
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
# Re-sync the clock from SNTP every 6 hours.
CONFIG_LWIP_SNTP_UPDATE_DELAY=21600000

# Memory for the HTTPS update check and download next to BLE and Wi-Fi. A TLS
# handshake needs a big contiguous block; without these it ran out of memory
# (mbedtls -0x3000 with ~44 KB free). Buffers are made when needed and freed
# between records, and Wi-Fi keeps fewer buffers.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# Both the update server (Cloudflare, Google Trust Services) and GitHub
# (Sectigo) send a chain whose top certificate is a *cross-signed* root. The
# bundle holds the self-signed root, so without this every handshake ended in
# "No matching trusted root certificate found".
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y

# Wi-Fi code in flash, not IRAM. The IRAM copies take internal RAM that the
# heap needs: the pump's own HTTPS download dipped to 9 KB free with them on.
# Costs some Wi-Fi throughput, which a 4.2 KB-per-frame control link and a
# 700 KB update don't need.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

# Trim Wi-Fi and network memory (see docs/CONFIGURATION.md, "Memory"). Station
# mode only, a handful of sockets, fewer packet buffers.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=12
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_LWIP_MAX_SOCKETS=6
CONFIG_LWIP_MAX_ACTIVE_TCP=8
CONFIG_LWIP_MAX_LISTENING_TCP=4
CONFIG_MDNS_MAX_SERVICES=2
# No receive aggregation: its reorder window holds packets in RAM, and none of
# this traffic needs the speed.
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
