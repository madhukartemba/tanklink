# ESP32-C3 SuperMini / kitchen-gas-alarm board (USB Serial/JTAG)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# NimBLE (not Bluedroid / not Mesh)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y

# Same pins as kitchen gas alarm C3
CONFIG_PUMP_ENABLE_NEOPIXEL=y
CONFIG_PUMP_NEOPIXEL_GPIO=5
CONFIG_PUMP_NEOPIXEL_COUNT=1
CONFIG_PUMP_ENABLE_BUTTON=y
CONFIG_PUMP_BUTTON_GPIO=3
CONFIG_PUMP_BUTTON_ACTIVE_LOW=y
CONFIG_PUMP_PAIRING_HOLD_MS=5000
CONFIG_PUMP_PAIRING_TIMEOUT_MS=60000
