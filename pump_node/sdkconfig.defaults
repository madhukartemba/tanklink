# ESP32-C3 fresh board — USB Serial/JTAG
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_ota.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_ota.csv"
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512

CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_GAP_SERVICE=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=5

# Fresh C3 pin map (see README). Relays unassigned until wired.
CONFIG_PUMP_ENABLE_NEOPIXEL=y
CONFIG_PUMP_NEOPIXEL_GPIO=20
CONFIG_PUMP_NEOPIXEL_COUNT=11
CONFIG_PUMP_ENABLE_BUTTON=y
CONFIG_PUMP_BUTTON_START_GPIO=0
CONFIG_PUMP_BUTTON_STOP_GPIO=1
CONFIG_PUMP_BUTTON_ACTIVE_LOW=y
CONFIG_PUMP_PAIRING_HOLD_MS=5000
CONFIG_PUMP_PAIRING_TIMEOUT_MS=60000
CONFIG_PUMP_ENABLE_BUZZER=y
CONFIG_PUMP_BUZZER_GPIO=21
CONFIG_PUMP_RELAY_START_GPIO=-1
CONFIG_PUMP_RELAY_STOP_GPIO=-1
CONFIG_PUMP_RELAY_ACTIVE_HIGH=y
CONFIG_PUMP_RELAY_PULSE_MS=400

CONFIG_PUMP_ENABLE_LORA=y
CONFIG_PUMP_LORA_SCK_GPIO=10
CONFIG_PUMP_LORA_MOSI_GPIO=3
CONFIG_PUMP_LORA_MISO_GPIO=2
CONFIG_PUMP_LORA_CS_GPIO=5
CONFIG_PUMP_LORA_RST_GPIO=4
CONFIG_PUMP_LORA_DIO0_GPIO=8
CONFIG_PUMP_LORA_FREQ_HZ=433000000
